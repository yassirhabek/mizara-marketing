# --- Database (Neon) ---------------------------------------------------------
# Use the POOLED connection string ("-pooler" host). Required.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/mizara_marketing?sslmode=require"

# --- SMTP (waitlist confirmation email) -------------------------------------
# Any transactional provider: Resend SMTP, Postmark, Fastmail, Mailpit (local).
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="re_xxxxxxxx"
MAIL_FROM="Mizara <hallo@mizara.app>"

# --- URLs ------------------------------------------------------------------
# Public origin of this marketing site (no trailing slash). Required.
NEXT_PUBLIC_SITE_URL="https://mizara.app"
# Where "Sign in" links to (the app).
NEXT_PUBLIC_APP_URL="https://app.mizara.app"

